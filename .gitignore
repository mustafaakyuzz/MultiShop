*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.mdf
*.ldf

# IdentityServer4 geliştirme anahtarları
tempkey.rsa
tempkey.jwk

# Gizli / yerel ayarlar
appsettings.Local.json
secrets.json

# OS dosyaları
Thumbs.db
Desktop.ini
.DS_Store

# Yedek / geçici
*.bak
*.tmp
_ReSharper*/
*.DotSettings.user